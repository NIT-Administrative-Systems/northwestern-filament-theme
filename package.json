{
    "private": true,
    "scripts": {
        "build": "vite build",
        "build:check": "tmp=$(mktemp) && git diff -- dist/theme.css dist/tokens.css dist/tailwind-tokens.css > \"$tmp\" && vite build && git diff -- dist/theme.css dist/tokens.css dist/tailwind-tokens.css | diff -u \"$tmp\" -; status=$?; rm -f \"$tmp\"; exit $status",
        "format": "prettier --write \"**/*.{blade.php,css,md,json,yml,xml}\"",
        "format:check": "prettier --check \"**/*.{blade.php,css,md,json,yml,xml}\"",
        "lint:css": "stylelint \"resources/css/**/*.css\"",
        "lint:css:fix": "stylelint \"resources/css/**/*.css\" --fix"
    },
    "devDependencies": {
        "@nu-appdev/northwestern-tokens": "^1.0.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@shufo/prettier-plugin-blade": "^1.16.3",
        "@types/node": "^26.6.6",
        "consola": "^3.4.2",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.0.3",
        "stylelint": "^17.16.0",
        "stylelint-config-recess-order": "^7.9.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-order": "^8.1.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">= 24.0.0",
        "npm": "please-use-pnpm",
        "pnpm": ">= 10.0.0",
        "yarn": "please-use-pnpm"
    }
}
